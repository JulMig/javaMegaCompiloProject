;(- 1)
LOADL 1
SUBR INeg
;(i > 0)
LOADA 0[SB]
LOADI (1)
LOADL 0
SUBR IGtr
JUMPIF (0) sinon_1
;(i + 1)
LOADA 0[SB]
LOADI (1)
LOADL 1
SUBR IAdd
LOADA 0[SB]
STOREI (1)
POP (0) 0
JUMP fin_si_1
;(i - 1)
sinon_1
LOADA 0[SB]
LOADI (1)
LOADL 1
SUBR ISub
LOADA 0[SB]
STOREI (1)
POP (0) 0
fin_si_1
LOADA 0[SB]
LOADI (1)
SUBR IOut
POP (0) -1
HALT

